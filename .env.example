# LLM: Groq (OpenAI-compatible). Server-side only; never expose these to the browser.
# Get a key at https://console.groq.com/keys. Leave LLM_API_KEY empty to run with heuristic ranking only.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model: openai/gpt-oss-120b (llama-3.3-70b-versatile is decommissioned on Groq)
LLM_MODEL=openai/gpt-oss-120b
# Optional reasoning effort for gpt-oss: low | medium | high. Leave empty for the model default.
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=20
# Keep prompts small: tokens-per-minute (8K) is the tightest Groq limit, not requests-per-minute.
LLM_MAX_COMPLETION_TOKENS=1024
LLM_MAX_CANDIDATES=15

# Groq limits for openai/gpt-oss-120b. Enforced before every call, with the safety margin applied
# (0.9 = use at most 90%). Usage is stored in LLM_USAGE_DB so daily counters survive restarts.
# A value <= 0 disables that check. Change these if your Groq plan differs.
LLM_RPM_LIMIT=30
LLM_RPD_LIMIT=1000
LLM_TPM_LIMIT=8000
LLM_TPD_LIMIT=200000
LLM_LIMIT_MARGIN=0.9
LLM_USAGE_DB=data/processed/llm_usage.sqlite

# Identical searches are answered from memory and spend no LLM quota.
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=256

# Max POST /recommendations per client IP per minute (<= 0 disables). Over the cap -> HTTP 429 + Retry-After.
RATE_LIMIT_PER_MINUTE=10

# Catalog
DATABASE_PATH=data/processed/restaurants.sqlite

# Retrieval / ranking
TOP_K=20
RESULT_LIMIT=5

# Retrieval tuning
MIN_CANDIDATES=8
BUDGET_LOW_MAX=400
BUDGET_MEDIUM_MAX=800
BUDGET_SOFT_MARGIN=100

# Comma-separated origins allowed to call the API (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
